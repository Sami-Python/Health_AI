# ========================================
# Firebase Configuration
# ========================================
GOOGLE_APPLICATION_CREDENTIALS=service_account_key.json

# ========================================
# Encryption (CRITICAL - REQUIRED)
# ========================================
# Generate a NEW key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: Never commit the actual key to Git!
# Store in environment variables or secret manager in production.
ENCRYPTION_KEY=your-generated-key-here

# ========================================
# Optional Configuration
# ========================================
# GARMIN_USERNAME=your_email@example.com (Legacy - not used in per-user mode)
# GARMIN_PASSWORD=your_password (Legacy - not used in per-user mode)
