rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Admin emails should be configured in environment
      // For now, check via custom claims (set via Firebase Admin SDK)
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Default: Deny all access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Goals: Users can only access their own goals
    match /goals/{goalId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
    
    // Workouts: Users can only access their own workouts
    match /workouts/{workoutId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
    
    // Plans: Users can only access their own AI-generated plans
    match /plans/{planId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
    
    // Users: Users can only access their own profile and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Subcollections (e.g., garmin_credentials, daily_insights)
      match /{subcollection}/{document} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Feedback: Users can create feedback, admins can read all
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      // Only admins can update/delete feedback
      allow update, delete: if isAdmin();
    }
  }
}
